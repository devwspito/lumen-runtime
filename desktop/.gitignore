# Rust / Tauri build output
src-tauri/target/

# Tauri-generated ACL/permission schemas (regenerated by `tauri-build` on every build)
src-tauri/gen/schemas/
# Same generated-by-tauri-build category, current tauri-build (2.6.3) writes it here too.
src-tauri/permissions/autogenerated/

# Local bundles
src-tauri/bundle/

# Staged runtime (podman + machine image) — fetched + sha256-verified by
# scripts/stage-runtime.sh from the committed runtime-manifest.lock. Never
# committed: it is large (tens to hundreds of MB per target) and fully
# reproducible from the lock file.
src-tauri/resources/runtime/
